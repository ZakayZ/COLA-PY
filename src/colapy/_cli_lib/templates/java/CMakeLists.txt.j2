cmake_minimum_required(
    VERSION
        3.20
)
project(
    {{ name }}
    VERSION
        {{ version }}
    LANGUAGES
        CXX
)
find_package(
    COLA_JVM
    CONFIG
    REQUIRED
)
include(
    GNUInstallDirs
)

# Implement the methods and make the registered classes concrete before running.
# This helper builds and installs both the native module and its JAR.
add_cola_gradle_library(
    {{ name }}
    JAR
    "build/libs/{{ name }}-all.jar"
    GENERATORS
    "{{ name }}Generator=org.cola.generated.{{ package }}.{{ name }}Generator"
    CONVERTERS
    "{{ name }}Converter=org.cola.generated.{{ package }}.{{ name }}Converter"
    WRITERS
    "{{ name }}Writer=org.cola.generated.{{ package }}.{{ name }}Writer"
)
